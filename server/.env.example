# Backend Environment Variables
# Copy this file to .env and fill in values

# Server port
PORT=5001

# MongoDB connection string (Atlas or local)
# Local: mongodb://localhost:27017/mathtug
# Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/mathtug?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://ahmedshaikhassan_db_user:PASSWORD@cluster0.h5prwwe.mongodb.net/mathtug?retryWrites=true&w=majority

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Production: https://mathtug.vercel.app
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
